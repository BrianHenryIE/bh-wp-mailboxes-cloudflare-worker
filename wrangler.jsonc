{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bh-wp-mailboxes-incoming-email-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-08",
  // The WordPress site URL is not configured here — it is entered on the
  // worker's /setup web form and stored in KV, so the same deployment can be
  // pointed (or re-pointed) at a site entirely from the browser.
  "kv_namespaces": [
    {
      "binding": "WORKER_CONFIGURATION_KV",
      // Replace with a real namespace id: `wrangler kv namespace create WORKER_CONFIGURATION_KV`
      "id": "REPLACE_WITH_KV_NAMESPACE_ID",
    },
  ],
  // Delivery-failure alerting (at most one email per day, sent through
  // Cloudflare Email Routing — independent of the WordPress site). The binding
  // is always deployed; the sender/recipient addresses are entered on the
  // /setup web UI and stored in KV. Alerts are sent only once addresses are
  // configured there, and the recipient must be a verified Email Routing
  // destination address on this zone.
  "send_email": [{ "name": "ALERT_EMAIL" }],
  // Secrets (set with `wrangler secret put <name>` after the first deploy):
  //   SETUP_TOKEN (optional) — token protecting the /setup routes. When unset,
  //   the token is chosen on the /setup web UI on first visit and stored
  //   (hashed) in KV; the secret, when set, always takes precedence.
}
