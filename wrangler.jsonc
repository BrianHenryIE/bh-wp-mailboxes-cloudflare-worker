{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bh-wp-mailboxes-incoming-email-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-08",
  // The WordPress site URL is not configured here — it is entered on the
  // worker's /setup web form and stored in KV, so the same deployment can be
  // pointed (or re-pointed) at a site entirely from the browser.
  "kv_namespaces": [
    {
      "binding": "WORKER_CONFIGURATION_KV",
      // Replace with a real namespace id: `wrangler kv namespace create WORKER_CONFIGURATION_KV`
      "id": "REPLACE_WITH_KV_NAMESPACE_ID",
    },
  ],
  // Secrets (set with `wrangler secret put <name>` after the first deploy):
  //   SETUP_TOKEN — one-time token protecting the /setup routes.
  //
  // Optional delivery-failure alerting (at most one email per day, sent through
  // Cloudflare Email Routing — independent of the WordPress site). To enable,
  // uncomment the binding and vars, and note the recipient must be a verified
  // Email Routing destination address on this zone:
  // "send_email": [
  //   { "name": "ALERT_EMAIL" },
  // ],
  // "vars": {
  //   "ALERT_FROM_EMAIL_ADDRESS": "worker@example.org",
  //   "ALERT_RECIPIENT_EMAIL_ADDRESS": "admin@example.net",
  // },
}
